// Data model for the NEEDL lead & consultation app.
// All timestamps are stored in UTC; the UI renders them in Europe/Berlin.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & tattooers
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TATTOOER
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        Role
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tattooerProfile   TattooerProfile?
  leadNotes         LeadNote[]
  sentMessages      Message[]
  botDisabledLeads  Lead[]             @relation("BotDisabledBy")
  contentItems      ContentItem[]
  pushSubscriptions PushSubscription[]
}

enum CalendarProvider {
  GOOGLE
  TEAMUP
}

model TattooerProfile {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationMinutes Int    @default(30)
  bufferMinutes       Int    @default(0)

  // Google Calendar connection (phase 2). Refresh token is stored encrypted.
  googleAccountEmail       String?
  googleRefreshTokenEnc    String?
  consultationCalendarId   String?
  // Name last applied to that calendar (renamed automatically when it changes)
  consultationCalendarName String?
  googleConnectedAt        DateTime?
  // Google app calendar kept while TeamUp is used (so switching back reuses it)
  googleCalendarId         String?

  // Which calendar this tattooer uses. consultationCalendarId is the current app calendar:
  // a Google calendar id, or "teamup:<subcalendar id>" for the shared TeamUp calendar.
  calendarProvider      CalendarProvider @default(GOOGLE)
  // TeamUp: value of the studio's "Artist" field that marks this tattooer's entries
  teamupArtist          String?
  teamupArtistLabel     String?
  // Own TeamUp sub-calendar of this tattooer (null = the studio's default from the settings)
  teamupSubcalendarId   String?
  teamupSubcalendarName String?
  // Local day (YYYY-MM-DD) of the last morning push about consultations without outcome
  outcomeReminderOn     String?
  teamupConnectedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  consultations          Consultation[]
  fairnessShare          FairnessShare?
}

// Recurring weekly availability, in local time (Europe/Berlin).
model AvailabilityRule {
  id          String          @id @default(cuid())
  tattooerId  String
  tattooer    TattooerProfile @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  // ISO weekday: 1 = Monday ... 7 = Sunday
  weekday     Int
  // Minutes since local midnight
  startMinute Int
  endMinute   Int
  // Optional validity, inclusive local dates
  validFrom   DateTime?       @db.Date
  validUntil  DateTime?       @db.Date
  createdAt   DateTime        @default(now())

  @@index([tattooerId])
}

enum AvailabilityExceptionKind {
  UNAVAILABLE
  AVAILABLE
}

model AvailabilityException {
  id         String                    @id @default(cuid())
  tattooerId String
  tattooer   TattooerProfile           @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  kind       AvailabilityExceptionKind @default(UNAVAILABLE)
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  createdAt  DateTime                  @default(now())

  @@index([tattooerId, startsAt])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadSource {
  META_LEAD_AD
  MANUAL
}

enum LeadStatus {
  NEW // neu
  CONTACTED // kontaktiert
  IN_CHAT // im_chat
  CONSULTATION_BOOKED // termin_gebucht
  CONSULTATION_DONE // beratung_erfolgt
  TATTOO_BOOKED // tattoo_gebucht
  NO_TATTOO // kein_tattoo
  NO_SHOW // no_show
  CANCELLED // abgesagt
  NO_RESPONSE // keine_antwort
  INVALID // ungueltig
}

model Lead {
  id     String     @id @default(cuid())
  source LeadSource

  // Meta Lead Ads metadata
  metaLeadId       String?   @unique
  metaPageId       String?
  metaFormId       String?
  metaCampaignId   String?
  metaCampaignName String?
  metaAdsetId      String?
  metaAdsetName    String?
  metaAdId         String?
  metaAdName       String?
  metaPlatform     String?
  metaCreatedAt    DateTime?

  // Contact data
  name       String
  phoneRaw   String?
  phoneE164  String?
  phoneValid Boolean @default(false)
  email      String?

  // WhatsApp consent (snapshot of the wording at the time of the lead)
  whatsappConsent     Boolean   @default(false)
  whatsappConsentAt   DateTime?
  whatsappConsentText String?

  status          LeadStatus @default(NEW)
  statusChangedAt DateTime   @default(now())

  // WhatsApp conversation state
  firstContactedAt DateTime?
  lastOutboundAt   DateTime?
  // Last customer message; free-form messages are allowed for 24 h after it
  lastInboundAt    DateTime?
  // Customer asked not to be contacted (e.g. "STOP"); blocks all automatic messages
  whatsappOptOut   Boolean   @default(false)

  // Chatbot in this chat. Switched off when a person replies (takeover) or manually.
  botEnabled        Boolean   @default(true)
  botDisabledAt     DateTime?
  // HUMAN_TAKEOVER | MANUAL
  botDisabledReason String?
  botDisabledById   String?
  botDisabledBy     User?     @relation("BotDisabledBy", fields: [botDisabledById], references: [id], onDelete: SetNull)

  // Structured tattoo idea, filled by the chatbot (phase 3)
  tattooSummary Json?

  // Short memory the built-in bot keeps about the chat (max. 400 characters)
  botMemory               String?
  // Why the bot handed the chat over to a person (shown in the app)
  botHandoverNote         String?
  botHandoverAt           DateTime?
  // Someone confirmed with the button that the handover was dealt with (list entry gone)
  botHandoverResolvedAt   DateTime?
  botHandoverResolvedById String?

  // Created by the bot test (AI test customers); hidden everywhere, deleted after the run
  isTest Boolean @default(false)

  // Original lead payload from Meta, for traceability
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages         Message[]
  consultations    Consultation[]
  notes            LeadNote[]
  outboundMessages OutboundMessage[]
  attachments      LeadAttachment[]
  botDeliveries    BotDelivery[]
  botTurns         BotTurn[]

  @@index([status])
  @@index([createdAt])
  @@index([metaCampaignId])
  @@index([phoneE164])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// WhatsApp messages (phase 3)
// ---------------------------------------------------------------------------

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id           String           @id @default(cuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction    MessageDirection
  waMessageId  String?          @unique
  templateName String?
  body         String?
  // sent | delivered | read | failed (outbound), received (inbound)
  status       String?
  errorCode    Int?
  payload      Json?
  outboundId   String?          @unique
  outbound     OutboundMessage? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  // Set for manual replies written in the app (null = automatic or inbound)
  sentById     String?
  sentBy       User?            @relation(fields: [sentById], references: [id], onDelete: SetNull)
  // Written by the chatbot via the bot API
  sentByBot    Boolean          @default(false)
  attachments  LeadAttachment[]
  sentAt       DateTime         @default(now())
  createdAt    DateTime         @default(now())

  @@index([leadId, sentAt])
}

// ---------------------------------------------------------------------------
// Consultations & revenue (phases 2 and 4)
// ---------------------------------------------------------------------------

enum ConsultationMode {
  ON_SITE // vor Ort (Standard)
  PHONE // per Telefon, wenn der Kunde nicht anreisen kann
}

enum SessionPlan {
  SINGLE // ein Termin
  MULTIPLE // mehrere Termine
}

enum ConsultationStatus {
  SCHEDULED
  HELD
  NO_SHOW
  CANCELLED
}

model Consultation {
  id                       String             @id @default(cuid())
  leadId                   String
  lead                     Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tattooerId               String
  tattooer                 TattooerProfile    @relation(fields: [tattooerId], references: [id])
  startsAt                 DateTime
  endsAt                   DateTime
  status                   ConsultationStatus @default(SCHEDULED)
  mode                     ConsultationMode   @default(ON_SITE)
  calendarEventId          String?
  // Calendar id the event was written to (the tattooer's "Beratungen" calendar)
  calendarId               String?
  cancelledAt              DateTime?
  // Cancelled only because it was moved to a new appointment (not a real cancellation)
  rescheduled              Boolean            @default(false)
  createdById              String?
  // Walk-in customer: tattoo project without a consultation. Holds the tattoo sessions only and
  // is excluded from every consultation list, count, fairness and reminder.
  walkIn                   Boolean            @default(false)
  // Outcome entered after the consultation (status HELD / NO_SHOW / CANCELLED)
  outcomeNote              String?
  tattooBooked             Boolean?
  // Tattoo needs one or several sessions
  sessionPlan              SessionPlan?
  // For MULTIPLE: false = only the first session is scheduled so far, true = further ones too
  furtherSessionsScheduled Boolean?
  outcomeRecordedAt        DateTime?
  outcomeRecordedById      String?
  // Follow-up: customer is interested but undecided – contact again on this day (09:00 local)
  followUpAt               DateTime?
  followUpDoneAt           DateTime?
  followUpNotifiedAt       DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  tattooBookings   TattooBooking[]
  outboundMessages OutboundMessage[]
  attachments      LeadAttachment[]

  @@index([tattooerId, startsAt])
  @@index([leadId])
}

model TattooBooking {
  id                    String       @id @default(cuid())
  consultationId        String
  consultation          Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  // 1, 2, 3 … within the tattoo
  sessionNumber         Int          @default(1)
  // Local day of the session (stored as local midnight)
  date                  DateTime
  // Optional time slot; shown in the calendar and blocks consultation slots
  startsAt              DateTime?
  endsAt                DateTime?
  // Google Calendar sync (same app calendar as the consultations)
  calendarId            String?
  calendarEventId       String?
  calendarSyncPending   Boolean      @default(false)
  calendarSyncError     String?
  calendarSyncedAt      DateTime?
  // Automatic retries back off (1, 2, 4 … min, max. 60 min); a manual retry ignores this
  calendarSyncAttempts  Int          @default(0)
  calendarNextAttemptAt DateTime?
  // Entered manually; may be added later
  amountCents           Int?
  currency              String       @default("EUR")
  cancelled             Boolean      @default(false)
  note                  String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([date])
  @@index([startsAt])
  @@index([calendarSyncPending])
}

// ---------------------------------------------------------------------------
// Fairness (phase 2)
// ---------------------------------------------------------------------------

model FairnessConfig {
  id         Int      @id @default(1)
  windowDays Int      @default(28)
  updatedAt  DateTime @updatedAt
}

model FairnessShare {
  tattooerId String          @id
  tattooer   TattooerProfile @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  // Raw weight; shares are normalised to 100 % across active tattooers on read.
  weight     Float           @default(1)
  updatedAt  DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Settings & infrastructure
// ---------------------------------------------------------------------------

// Singleton row (id = 1) with settings the admin can change in the UI.
model AppSettings {
  id                    Int      @id @default(1)
  // Key of the consent checkbox in the Meta instant form (custom disclaimer).
  consentCheckboxKey    String?
  // Exact wording of the consent text shown in the form; snapshotted per lead.
  consentText           String?
  // Studio name, available as {{Studio}} in WhatsApp templates
  studioName            String?
  // Address used as location of on-site consultations in calendar events
  studioAddress         String?
  // TeamUp (shared studio calendar): sub-calendar the app writes to and the "Artist" field
  // ("who" = TeamUp's built-in "Wer" field, otherwise the id of a custom field)
  teamupSubcalendarId   String?
  teamupSubcalendarName String?
  teamupArtistFieldId   String?
  teamupArtistFieldName String?
  // Consultation forms offered (manual booking and bot) and whether it is free
  consultationOnSite    Boolean  @default(true)
  consultationPhone     Boolean  @default(true)
  consultationFree      Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD
}

// Every incoming webhook unit of work, deduplicated by (provider, externalId).
model WebhookEvent {
  id            String             @id @default(cuid())
  provider      String
  externalId    String
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([provider, externalId])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// WhatsApp sending (phase 3)
// ---------------------------------------------------------------------------

enum TemplatePurpose {
  FIRST_CONTACT
  FOLLOW_UP
  REMINDER
  AFTER_CONSULTATION
}

enum TemplateCategory {
  UTILITY
  MARKETING
}

enum TemplateStatus {
  DRAFT // not yet submitted to Meta
  PENDING // submitted, waiting for review
  APPROVED
  REJECTED
  PAUSED // paused/disabled by Meta (quality)
}

// Message template maintained in the app and submitted to Meta for approval.
// The admin writes named placeholders ({{Vorname}}); Meta gets positional ones ({{1}}).
model WhatsAppTemplate {
  id              String           @id @default(cuid())
  purpose         TemplatePurpose
  // Base name at Meta (lowercase letters, digits, underscore); versions get "_v2", "_v3", …
  name            String
  language        String           @default("de")
  category        TemplateCategory @default(UTILITY)
  // Current text in the editor (named placeholders)
  bodyText        String
  // Review status of the latest submission
  status          TemplateStatus   @default(DRAFT)
  submissionCount Int              @default(0)
  submittedName   String?
  submittedText   String?
  metaTemplateId  String?
  rejectedReason  String?
  submittedAt     DateTime?
  // Version Meta approved last. It keeps being sent while a newer version is under review.
  approvedName    String?
  approvedText    String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  followUpSteps    FollowUpStep[]
  reminderRules    ReminderRule[]
  afterRules       AfterConsultationRule[]
  outboundMessages OutboundMessage[]

  @@unique([name, language])
}

// Singleton (id = 1): sending schedule and anti-spam staggering.
model MessagingSettings {
  id                     Int       @id @default(1)
  // Master switch; nothing is sent while false
  sendingEnabled         Boolean   @default(false)
  // Set automatically on quality drops / spam-related errors, or manually
  pausedAt               DateTime?
  pausedReason           String?
  // Fixed send times for first contact and follow-ups: [{ weekday: 1-7, time: "HH:MM" }]
  sendTimes              Json      @default("[]")
  // A batch runs from a send time for at most this long
  batchWindowMinutes     Int       @default(90)
  maxPerBatch            Int       @default(15)
  maxPerDay              Int       @default(40)
  // Random gap between two messages
  minGapSeconds          Int       @default(60)
  maxGapSeconds          Int       @default(180)
  // Warm-up for a new number: start limit, increase per day until maxPerDay
  warmupStartDate        DateTime? @db.Date
  warmupStartPerDay      Int       @default(10)
  warmupIncreasePerDay   Int       @default(5)
  // Lead becomes "keine Antwort" this long after the last follow-up without reply
  noResponseAfterHours   Int       @default(48)
  firstContactTemplateId String?
  // Runtime state of the dispatcher
  nextSendAllowedAt      DateTime?
  // Lease so only one worker process dispatches at a time
  workerLeaseUntil       DateTime?
  lastWorkerRunAt        DateTime?
  // Master switch for the chatbot in all chats
  botGloballyEnabled     Boolean   @default(true)
  updatedAt              DateTime  @updatedAt
}

model FollowUpStep {
  id         String           @id @default(cuid())
  position   Int
  // Hours after the previous message (first contact or previous follow-up)
  delayHours Int
  templateId String
  template   WhatsAppTemplate @relation(fields: [templateId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([position])
}

model ReminderRule {
  id          String           @id @default(cuid())
  hoursBefore Int              @unique
  templateId  String
  template    WhatsAppTemplate @relation(fields: [templateId], references: [id])
  createdAt   DateTime         @default(now())
}

enum OutboundKind {
  FIRST_CONTACT
  FOLLOW_UP
  REMINDER
  AFTER_CONSULTATION
}

// Which consultations an "after the consultation" message is for
enum AfterConsultationCondition {
  HELD // every consultation that took place
  TATTOO_BOOKED // took place and a tattoo was booked
  UNDECIDED // took place, customer still deciding
  NO_TATTOO // took place, no tattoo
  NO_SHOW // customer did not come
}

model AfterConsultationRule {
  id         String                     @id @default(cuid())
  hoursAfter Int
  condition  AfterConsultationCondition
  templateId String
  template   WhatsAppTemplate           @relation(fields: [templateId], references: [id])
  createdAt  DateTime                   @default(now())

  outboundMessages OutboundMessage[]

  @@unique([hoursAfter, condition])
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED // no longer applicable (customer replied, consultation cancelled, …)
}

// Queue of automatic template messages. The unique key makes planning idempotent.
model OutboundMessage {
  id             String                 @id @default(cuid())
  leadId         String
  lead           Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?          @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  kind           OutboundKind
  // Follow-up position, reminder hours or hours after the consultation; 0 for first contact
  step           Int                    @default(0)
  afterRuleId    String?
  afterRule      AfterConsultationRule? @relation(fields: [afterRuleId], references: [id], onDelete: SetNull)
  // Uniqueness key: lead (first contact/follow-up) or consultation (reminder)
  dedupeKey      String                 @unique
  templateId     String
  template       WhatsAppTemplate       @relation(fields: [templateId], references: [id])
  notBefore      DateTime
  status         OutboundStatus         @default(QUEUED)
  attempts       Int                    @default(0)
  lastError      String?
  waMessageId    String?
  sentAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  message Message?

  @@index([status, notBefore])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Chatbot interface (phase 3b)
// ---------------------------------------------------------------------------

enum AttachmentStatus {
  PENDING // waiting for download from WhatsApp
  STORED
  FAILED
}

// Files customers send (reference images). Stored privately on disk, never public.
model LeadAttachment {
  id             String           @id @default(cuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // Consultation the file belongs to (reference images): the next consultation when it
  // arrives, otherwise attached when a consultation is booked
  consultationId String?
  consultation   Consultation?    @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  waMediaId      String?          @unique
  mimeType       String?
  fileName       String?
  sizeBytes      Int?
  caption        String?
  status         AttachmentStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  // Path relative to MEDIA_STORAGE_DIR
  storagePath    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([consultationId])
}

// Outgoing events to the chatbot (signed webhook), delivered with retries by the worker.
model BotDelivery {
  id            String             @id @default(cuid())
  leadId        String?
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, nextAttemptAt])
}

// Calendar events that still have to be removed in Google (e.g. after a session
// was replaced or a lead was deleted). No relation on purpose: the source row is gone.
model CalendarEventDeletion {
  id         String   @id @default(cuid())
  tattooerId String
  calendarId String
  eventId    String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())

  @@unique([calendarId, eventId])
}

// ---------------------------------------------------------------------------
// Content for Meta ads (photos/videos uploaded by the team)
// ---------------------------------------------------------------------------

enum ContentKind {
  IMAGE
  VIDEO
}

model ContentItem {
  id            String      @id @default(cuid())
  uploaderId    String
  uploader      User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  kind          ContentKind
  mimeType      String
  sizeBytes     Int
  originalName  String
  // Relative path inside MEDIA_STORAGE_DIR (private, never served publicly)
  storagePath   String      @unique
  // Admin: picked for an upcoming ad
  selectedForAd Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([uploaderId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Billing: monthly commission invoices on the tattoo revenue booked through the app
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  OPEN
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  // "2026-001": sequential per year
  number        String        @unique
  // Billed month, local "YYYY-MM"
  period        String
  issuedAt      DateTime      @default(now())
  dueAt         DateTime
  // Frozen amounts at creation (cents; rates in basis points, 1500 = 15 %)
  revenueCents  Int
  sessionCount  Int
  commissionBps Int
  netCents      Int
  vatBps        Int
  vatCents      Int
  grossCents    Int
  // Snapshots: issuer/recipient address blocks and the billed sessions
  issuer        Json
  recipient     Json
  lines         Json
  status        InvoiceStatus @default(OPEN)
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([period])
}

// ---------------------------------------------------------------------------
// WhatsApp bot: studio knowledge the bot answers from (maintained by the admin)
// ---------------------------------------------------------------------------

model BotKnowledge {
  id               Int      @id @default(1)
  // Name the bot signs with, e.g. "Mia vom Black Rose Team" (optional)
  assistantName    String?
  about            String?
  team             String?
  location         String?
  openingHours     String?
  services         String?
  process          String?
  customerConcerns String?
  toneExamples     String?
  forbiddenWords   String?
  noGos            String?
  // { website, instagram, impressum, datenschutz }
  links            Json?
  // [{ q, a }]
  faq              Json?
  objections       Json?
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

// Billing settings of the operator (edited in the app by the operator only; env as fallback)
model BillingSettings {
  id            Int      @id @default(1)
  commissionBps Int?
  vatBps        Int?
  paymentDays   Int?
  issuerName    String?
  issuerAddress String?
  issuerTaxId   String?
  issuerIban    String?
  issuerEmail   String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

// One run of the built-in bot (answer to one or more customer messages):
// usage for costs/limits and what happened, for checking the bot later.
model BotTurn {
  id               String   @id @default(cuid())
  leadId           String
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  model            String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  // Cost in millionths of a US dollar (list prices of the model)
  costMicros       Int      @default(0)
  // sent | handover | silent | error
  outcome          String
  mode             String?
  reply            String?
  // Tools used, filter rejections, errors
  log              Json?
  error            String?
  createdAt        DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([createdAt])
}

// Safety limits of the built-in bot (single row, id = 1)
model BotSettings {
  id                 Int       @id @default(1)
  // Bot replies per customer
  maxPerHourPerLead  Int       @default(30)
  maxPerDayPerLead   Int       @default(80)
  // Bot replies across all chats per day
  maxPerDayTotal     Int       @default(1500)
  // Cost brake in euro cents (1 $ counted as 1 €, on the safe side)
  dailyBudgetCents   Int       @default(500)
  monthlyBudgetCents Int       @default(10000)
  // Paused automatically after repeated errors (or by hand); null = running
  pausedAt           DateTime?
  pausedReason       String?
  // Last alert sent (e.g. "budget-day:2026-11-05"), so each alert goes out once
  lastAlertKey       String?
  updatedAt          DateTime  @updatedAt
}

// Browser push subscriptions (installed PWA / browser) per user
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Test runs of the bot with AI test customers (operator page)
model BotEvalRun {
  id          String    @id @default(cuid())
  // PENDING | RUNNING | DONE | FAILED
  status      String    @default("PENDING")
  model       String?
  requestedBy String?
  startedAt   DateTime?
  finishedAt  DateTime?
  // Average grade (1 = best … 6 = worst), x100
  avgGrade    Int?
  costMicros  Int       @default(0)
  // One entry per test customer: persona, grade, problems, transcript
  results     Json?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// Access data of integrations (TeamUp, WhatsApp, Meta) maintained by the operator in the
// app. Secrets are AES-256-GCM encrypted (TOKEN_ENCRYPTION_KEY); the .env is the fallback.
model IntegrationSetting {
  // Name of the setting, same as the environment variable (e.g. WHATSAPP_ACCESS_TOKEN)
  key         String   @id
  // Encrypted for secrets, plain for IDs and modes
  value       String
  // Last characters of a secret, to recognise it without showing it
  hint        String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Who changed which access data when (never the value itself)
model IntegrationSettingLog {
  id        String   @id @default(cuid())
  key       String
  // set | cleared
  action    String
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
