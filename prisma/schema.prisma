// Data model for the TattAI lead & consultation app.
// All timestamps are stored in UTC; the UI renders them in Europe/Berlin.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & tattooers
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TATTOOER
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        Role
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tattooerProfile  TattooerProfile?
  leadNotes        LeadNote[]
  sentMessages     Message[]
  botDisabledLeads Lead[]           @relation("BotDisabledBy")
}

model TattooerProfile {
  id                  String @id @default(cuid())
  userId              String @unique
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationMinutes Int    @default(30)
  bufferMinutes       Int    @default(0)

  // Google Calendar connection (phase 2). Refresh token is stored encrypted.
  googleAccountEmail     String?
  googleRefreshTokenEnc  String?
  consultationCalendarId String?
  googleConnectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  consultations          Consultation[]
  fairnessShare          FairnessShare?
}

// Recurring weekly availability, in local time (Europe/Berlin).
model AvailabilityRule {
  id          String          @id @default(cuid())
  tattooerId  String
  tattooer    TattooerProfile @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  // ISO weekday: 1 = Monday ... 7 = Sunday
  weekday     Int
  // Minutes since local midnight
  startMinute Int
  endMinute   Int
  // Optional validity, inclusive local dates
  validFrom   DateTime?       @db.Date
  validUntil  DateTime?       @db.Date
  createdAt   DateTime        @default(now())

  @@index([tattooerId])
}

enum AvailabilityExceptionKind {
  UNAVAILABLE
  AVAILABLE
}

model AvailabilityException {
  id         String                    @id @default(cuid())
  tattooerId String
  tattooer   TattooerProfile           @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  kind       AvailabilityExceptionKind @default(UNAVAILABLE)
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  createdAt  DateTime                  @default(now())

  @@index([tattooerId, startsAt])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadSource {
  META_LEAD_AD
  MANUAL
}

enum LeadStatus {
  NEW // neu
  CONTACTED // kontaktiert
  IN_CHAT // im_chat
  CONSULTATION_BOOKED // termin_gebucht
  CONSULTATION_DONE // beratung_erfolgt
  TATTOO_BOOKED // tattoo_gebucht
  NO_TATTOO // kein_tattoo
  NO_SHOW // no_show
  CANCELLED // abgesagt
  NO_RESPONSE // keine_antwort
  INVALID // ungueltig
}

model Lead {
  id     String     @id @default(cuid())
  source LeadSource

  // Meta Lead Ads metadata
  metaLeadId       String?   @unique
  metaPageId       String?
  metaFormId       String?
  metaCampaignId   String?
  metaCampaignName String?
  metaAdsetId      String?
  metaAdsetName    String?
  metaAdId         String?
  metaAdName       String?
  metaPlatform     String?
  metaCreatedAt    DateTime?

  // Contact data
  name       String
  phoneRaw   String?
  phoneE164  String?
  phoneValid Boolean @default(false)
  email      String?

  // WhatsApp consent (snapshot of the wording at the time of the lead)
  whatsappConsent     Boolean   @default(false)
  whatsappConsentAt   DateTime?
  whatsappConsentText String?

  status          LeadStatus @default(NEW)
  statusChangedAt DateTime   @default(now())

  // WhatsApp conversation state
  firstContactedAt DateTime?
  lastOutboundAt   DateTime?
  // Last customer message; free-form messages are allowed for 24 h after it
  lastInboundAt    DateTime?
  // Customer asked not to be contacted (e.g. "STOP"); blocks all automatic messages
  whatsappOptOut   Boolean   @default(false)

  // Chatbot in this chat. Switched off when a person replies (takeover) or manually.
  botEnabled        Boolean   @default(true)
  botDisabledAt     DateTime?
  // HUMAN_TAKEOVER | MANUAL
  botDisabledReason String?
  botDisabledById   String?
  botDisabledBy     User?     @relation("BotDisabledBy", fields: [botDisabledById], references: [id], onDelete: SetNull)

  // Structured tattoo idea, filled by the chatbot (phase 3)
  tattooSummary Json?

  // Original lead payload from Meta, for traceability
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages         Message[]
  consultations    Consultation[]
  notes            LeadNote[]
  outboundMessages OutboundMessage[]
  attachments      LeadAttachment[]
  botDeliveries    BotDelivery[]

  @@index([status])
  @@index([createdAt])
  @@index([metaCampaignId])
  @@index([phoneE164])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// WhatsApp messages (phase 3)
// ---------------------------------------------------------------------------

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Message {
  id           String           @id @default(cuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction    MessageDirection
  waMessageId  String?          @unique
  templateName String?
  body         String?
  // sent | delivered | read | failed (outbound), received (inbound)
  status       String?
  errorCode    Int?
  payload      Json?
  outboundId   String?          @unique
  outbound     OutboundMessage? @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  // Set for manual replies written in the app (null = automatic or inbound)
  sentById     String?
  sentBy       User?            @relation(fields: [sentById], references: [id], onDelete: SetNull)
  // Written by the chatbot via the bot API
  sentByBot    Boolean          @default(false)
  attachments  LeadAttachment[]
  sentAt       DateTime         @default(now())
  createdAt    DateTime         @default(now())

  @@index([leadId, sentAt])
}

// ---------------------------------------------------------------------------
// Consultations & revenue (phases 2 and 4)
// ---------------------------------------------------------------------------

enum ConsultationMode {
  ON_SITE // vor Ort (Standard)
  PHONE // per Telefon, wenn der Kunde nicht anreisen kann
}

enum ConsultationStatus {
  SCHEDULED
  HELD
  NO_SHOW
  CANCELLED
}

model Consultation {
  id              String             @id @default(cuid())
  leadId          String
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tattooerId      String
  tattooer        TattooerProfile    @relation(fields: [tattooerId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  status          ConsultationStatus @default(SCHEDULED)
  mode            ConsultationMode   @default(ON_SITE)
  calendarEventId String?
  // Calendar id the event was written to (the tattooer's "Beratungen" calendar)
  calendarId      String?
  cancelledAt     DateTime?
  createdById     String?
  outcomeNote     String?
  tattooBooked    Boolean?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tattooBookings   TattooBooking[]
  outboundMessages OutboundMessage[]

  @@index([tattooerId, startsAt])
  @@index([leadId])
}

model TattooBooking {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  date           DateTime
  amountCents    Int
  currency       String       @default("EUR")
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([date])
}

// ---------------------------------------------------------------------------
// Fairness (phase 2)
// ---------------------------------------------------------------------------

model FairnessConfig {
  id         Int      @id @default(1)
  windowDays Int      @default(28)
  updatedAt  DateTime @updatedAt
}

model FairnessShare {
  tattooerId String          @id
  tattooer   TattooerProfile @relation(fields: [tattooerId], references: [id], onDelete: Cascade)
  // Raw weight; shares are normalised to 100 % across active tattooers on read.
  weight     Float           @default(1)
  updatedAt  DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Settings & infrastructure
// ---------------------------------------------------------------------------

// Singleton row (id = 1) with settings the admin can change in the UI.
model AppSettings {
  id                 Int      @id @default(1)
  // Key of the consent checkbox in the Meta instant form (custom disclaimer).
  consentCheckboxKey String?
  // Exact wording of the consent text shown in the form; snapshotted per lead.
  consentText        String?
  // Studio name, available as {{Studio}} in WhatsApp templates
  studioName         String?
  // Address used as location of on-site consultations in calendar events
  studioAddress      String?
  updatedAt          DateTime @updatedAt
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  DEAD
}

// Every incoming webhook unit of work, deduplicated by (provider, externalId).
model WebhookEvent {
  id            String             @id @default(cuid())
  provider      String
  externalId    String
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([provider, externalId])
  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// WhatsApp sending (phase 3)
// ---------------------------------------------------------------------------

enum TemplatePurpose {
  FIRST_CONTACT
  FOLLOW_UP
  REMINDER
}

enum TemplateCategory {
  UTILITY
  MARKETING
}

enum TemplateStatus {
  DRAFT // not yet submitted to Meta
  PENDING // submitted, waiting for review
  APPROVED
  REJECTED
  PAUSED // paused/disabled by Meta (quality)
}

// Message template maintained in the app and submitted to Meta for approval.
// The admin writes named placeholders ({{Vorname}}); Meta gets positional ones ({{1}}).
model WhatsAppTemplate {
  id              String           @id @default(cuid())
  purpose         TemplatePurpose
  // Base name at Meta (lowercase letters, digits, underscore); versions get "_v2", "_v3", …
  name            String
  language        String           @default("de")
  category        TemplateCategory @default(UTILITY)
  // Current text in the editor (named placeholders)
  bodyText        String
  // Review status of the latest submission
  status          TemplateStatus   @default(DRAFT)
  submissionCount Int              @default(0)
  submittedName   String?
  submittedText   String?
  metaTemplateId  String?
  rejectedReason  String?
  submittedAt     DateTime?
  // Version Meta approved last. It keeps being sent while a newer version is under review.
  approvedName    String?
  approvedText    String?
  approvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  followUpSteps    FollowUpStep[]
  reminderRules    ReminderRule[]
  outboundMessages OutboundMessage[]

  @@unique([name, language])
}

// Singleton (id = 1): sending schedule and anti-spam staggering.
model MessagingSettings {
  id                     Int       @id @default(1)
  // Master switch; nothing is sent while false
  sendingEnabled         Boolean   @default(false)
  // Set automatically on quality drops / spam-related errors, or manually
  pausedAt               DateTime?
  pausedReason           String?
  // Fixed send times for first contact and follow-ups: [{ weekday: 1-7, time: "HH:MM" }]
  sendTimes              Json      @default("[]")
  // A batch runs from a send time for at most this long
  batchWindowMinutes     Int       @default(90)
  maxPerBatch            Int       @default(15)
  maxPerDay              Int       @default(40)
  // Random gap between two messages
  minGapSeconds          Int       @default(60)
  maxGapSeconds          Int       @default(180)
  // Warm-up for a new number: start limit, increase per day until maxPerDay
  warmupStartDate        DateTime? @db.Date
  warmupStartPerDay      Int       @default(10)
  warmupIncreasePerDay   Int       @default(5)
  // Lead becomes "keine Antwort" this long after the last follow-up without reply
  noResponseAfterHours   Int       @default(48)
  firstContactTemplateId String?
  // Runtime state of the dispatcher
  nextSendAllowedAt      DateTime?
  // Lease so only one worker process dispatches at a time
  workerLeaseUntil       DateTime?
  lastWorkerRunAt        DateTime?
  // Master switch for the chatbot in all chats
  botGloballyEnabled     Boolean   @default(true)
  updatedAt              DateTime  @updatedAt
}

model FollowUpStep {
  id         String           @id @default(cuid())
  position   Int
  // Hours after the previous message (first contact or previous follow-up)
  delayHours Int
  templateId String
  template   WhatsAppTemplate @relation(fields: [templateId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([position])
}

model ReminderRule {
  id          String           @id @default(cuid())
  hoursBefore Int              @unique
  templateId  String
  template    WhatsAppTemplate @relation(fields: [templateId], references: [id])
  createdAt   DateTime         @default(now())
}

enum OutboundKind {
  FIRST_CONTACT
  FOLLOW_UP
  REMINDER
}

enum OutboundStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED // no longer applicable (customer replied, consultation cancelled, …)
}

// Queue of automatic template messages. The unique key makes planning idempotent.
model OutboundMessage {
  id             String           @id @default(cuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?    @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  kind           OutboundKind
  // Follow-up position or reminder hours; 0 for first contact
  step           Int              @default(0)
  // Uniqueness key: lead (first contact/follow-up) or consultation (reminder)
  dedupeKey      String           @unique
  templateId     String
  template       WhatsAppTemplate @relation(fields: [templateId], references: [id])
  notBefore      DateTime
  status         OutboundStatus   @default(QUEUED)
  attempts       Int              @default(0)
  lastError      String?
  waMessageId    String?
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  message Message?

  @@index([status, notBefore])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Chatbot interface (phase 3b)
// ---------------------------------------------------------------------------

enum AttachmentStatus {
  PENDING // waiting for download from WhatsApp
  STORED
  FAILED
}

// Files customers send (reference images). Stored privately on disk, never public.
model LeadAttachment {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  waMediaId   String?          @unique
  mimeType    String?
  fileName    String?
  sizeBytes   Int?
  caption     String?
  status      AttachmentStatus @default(PENDING)
  attempts    Int              @default(0)
  lastError   String?
  // Path relative to MEDIA_STORAGE_DIR
  storagePath String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([leadId])
  @@index([status])
}

// Outgoing events to the chatbot (signed webhook), delivered with retries by the worker.
model BotDelivery {
  id            String             @id @default(cuid())
  leadId        String?
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, nextAttemptAt])
}
