# Copy to .env and adjust. Secrets belong ONLY in environment variables.

# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://tattai:tattai@localhost:5432/tattai"
# Separate database for integration tests (gets reset by the tests!)
TEST_DATABASE_URL="postgresql://tattai:tattai@localhost:5432/tattai_test"

# --- App ----------------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Berlin"

# --- Auth (Auth.js) -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only accounts of this Google Workspace domain may sign in (empty = no domain check).
GOOGLE_WORKSPACE_DOMAIN=""
# This e-mail is created as admin automatically on first sign-in / seed.
ADMIN_EMAIL="inhaber@example.com"
ADMIN_NAME="Studio-Inhaber"
# Developer login without Google (sample users). Never enabled in production builds.
DEV_LOGIN_ENABLED="true"

# --- Meta Lead Ads ------------------------------------------------------------
META_APP_SECRET="dev-app-secret"
META_VERIFY_TOKEN="dev-verify-token"
META_PAGE_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v23.0"
# "true" = no calls to Meta; lead details are generated sample data.
META_GRAPH_MOCK="true"

# Default country for phone numbers without a country code.
PHONE_DEFAULT_COUNTRY="DE"

# --- Production only (deploy/docker-compose.prod.yml) -------------------------
# DATABASE_URL="postgresql://needl:<POSTGRES_PASSWORD>@db:5432/needl"
# POSTGRES_PASSWORD=""
# APP_DOMAIN="leads.example.de"
# APP_URL="https://leads.example.de"
# AUTH_URL="https://leads.example.de"
# DEV_LOGIN_ENABLED="false"
# META_GRAPH_MOCK="false"
# GOOGLE_CALENDAR_MOCK="false"
# WHATSAPP_MOCK="false"
# TEAMUP_MOCK="false"

# --- Google Calendar (phase 2) ------------------------------------------------
# Uses the same OAuth client as the login (AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET).
# Add redirect URI: <APP_URL>/api/google/callback
# "true" = no calls to Google; sample busy times, events are only logged.
GOOGLE_CALENDAR_MOCK="true"
# Key for encrypting refresh tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# --- TeamUp (alternative to Google Calendar, chosen per tattooer) --------------
# The studio shares one TeamUp calendar; the "Artist" field marks whose entry it is.
# Sub-calendar and artist field are chosen by the admin under "Einstellungen".
# "true" = no calls to TeamUp; sample sub-calendars, artist choices and busy times.
TEAMUP_MOCK="true"
# API key (requested from TeamUp) and calendar key (share link with
# "Ändern"-Berechtigung, the part after teamup.com/). Secrets: environment only.
TEAMUP_API_KEY=""
TEAMUP_CALENDAR_KEY=""

# --- WhatsApp Cloud API (phase 3) ----------------------------------------------
# "true" = nothing is sent; templates are approved immediately (sample mode).
WHATSAPP_MOCK="true"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Permanent system-user token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=""
# App secret of the Meta app receiving WhatsApp webhooks (defaults to META_APP_SECRET)
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="dev-whatsapp-verify-token"
WHATSAPP_API_VERSION="v23.0"

# --- Chatbot interface (phase 3b) ---------------------------------------------
# API key the bot sends as "Authorization: Bearer <key>" (min. 32 characters).
# Generate with: openssl rand -hex 32
BOT_API_KEY=""
# Where customer messages and chat events are sent (signed), e.g. https://bot.example.de/needl
BOT_WEBHOOK_URL=""
# Secret for the X-NEEDL-Signature header. Generate with: openssl rand -hex 32
BOT_WEBHOOK_SECRET=""
# Built-in WhatsApp bot (Claude). Set the key to switch it on; customer messages are
# then answered by NEEDL itself instead of being sent to BOT_WEBHOOK_URL.
ANTHROPIC_API_KEY=""
# Optional: model and effort (low | medium | high)
BOT_MODEL="claude-opus-5-5"
BOT_EFFORT="low"

# Private storage for customer files (reference images). Must NOT be publicly served.
MEDIA_STORAGE_DIR="./storage/media"

# --- Billing (commission invoices of the operator to the studio) ----------------
# Google address of the NEEDL operator (you): only this login may edit the billing
# details under Einstellungen. The BILLING_* values below are only the fallback.
OPERATOR_EMAIL=""
BILLING_COMMISSION_PERCENT="15"
# 19 = regular VAT, 0 = small business (§ 19 UStG note on the invoice)
BILLING_VAT_PERCENT="19"
BILLING_PAYMENT_DAYS="14"
BILLING_ISSUER_NAME=""
# Use \n for line breaks, e.g. "Musterweg 1\n10115 Berlin"
BILLING_ISSUER_ADDRESS=""
# Tax number or VAT ID (required on invoices)
BILLING_ISSUER_TAX_ID=""
BILLING_ISSUER_IBAN=""
BILLING_ISSUER_EMAIL=""
