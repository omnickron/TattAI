    "jobs:webhooks": "tsx scripts/retry-webhooks.ts",
    "dev:simulate-lead": "tsx scripts/simulate-lead.ts",
    "worker": "tsx scripts/worker.ts",
    "dev:simulate-whatsapp": "tsx scripts/simulate-whatsapp.ts",
